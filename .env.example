# --- GitHub ---
# Personal access token with repo:read scope (for private repos; public repos work without one, but rate limits are much lower)
GITHUB_TOKEN=

# --- AWS Bedrock ---
AWS_REGION=us-east-1
# Uses the default boto3 credential chain (aws configure / SSO / IAM role) — no keys needed here if already configured
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_FLAGS_CHANNEL=#lore-flags

# --- Microsoft Teams ---
TEAMS_INCOMING_WEBHOOK_URL=

# --- Lore app config ---
# Local path to the working copy of the repo the watcher should monitor (any repo, set per-deployment)
WATCH_REPO_PATH=
# owner/name of the GitHub repo to ingest (any repo, set per-deployment)
GITHUB_REPO=
LORE_DATA_DIR=./data
LORE_API_PORT=8000
